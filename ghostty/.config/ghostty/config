# https://ghostty.zerebos.com/
# shell-integration = bash
cursor-style = block
window-save-state = always
window-theme = system
# new GTK Tabs
#gtk-titlebar-style=tabs
gtk-toolbar-style = raised
gtk-titlebar-style = native


#background
background-opacity = 0.95
background-blur = 12
unfocused-split-opacity = 0.75

theme = dracula
# Fonts
font-size = 16
# font-feature = true
# font-family = "FiraCodeNerdFontMono-Retina"
# font-family = "Hack Nerd Font Mono"
font-family = "FiraMono Nerd Font Mono"

#keybinds
keybind = control+shift+n=text:\x01"
keybind = ctrl+enter=text:\r
keybind = shift+enter=text:\r
keybind = ctrl+shift+enter=text:\r
link-url = true

# Adding to fix SSH issues. Fine locally broken externally
# https://github.com/ghostty-org/ghostty/discussions/3161#discussioncomment-11671706
command = TERM=xterm-256color /usr/bin/bash

config-file = shaders.ghostty
alpha-blending = linear-corrected


config-file = ?auto/shader.ghostty