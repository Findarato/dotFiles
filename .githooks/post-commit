#!/usr/bin/env bash
#
# Post-commit hook: regenerate CHANGELOG.md after every commit.
# Uses OPENCODE_SKIP_CHANGELOG to guard against recursion.
#

set -e

# Guard against recursion from the amend below
if [ -n "$OPENCODE_SKIP_CHANGELOG" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHANGELOG="$REPO_ROOT/CHANGELOG.md"

# Skip if repo doesn't have a changelog yet
if [ ! -f "$CHANGELOG" ]; then
    exit 0
fi

# Skip if the last commit already updated the changelog (avoids extra cycle)
if git diff --name-only HEAD~1..HEAD 2>/dev/null | grep -q "CHANGELOG.md"; then
    exit 0
fi

tmpfile=$(mktemp)

cat > "$tmpfile" <<'EOF'
# Changelog

> Reminder: update this file on every commit.

The entries below were populated from the repository commit history and grouped by commit date.

EOF

git log --date=format:'%Y-%m-%d|%Y-W%V' --pretty=format:'%ad%x1f%h%x1f%an%x1f%s' | \
  awk -F"\x1f" '{split($1, d, "|"); date=d[1]; week=d[2]; hash=$2; author=$3; subject=$4; if (week!=prev){ if (prev!="") print ""; printf("## Week %s\n\n", week); prev=week } printf("- [%s] %s — %s\n", hash, subject, author)}' >> "$tmpfile"

# Check if anything actually changed
if diff -q "$CHANGELOG" "$tmpfile" >/dev/null 2>&1; then
    rm -f "$tmpfile"
    exit 0
fi

mv "$tmpfile" "$CHANGELOG"
git add "$CHANGELOG"
OPENCODE_SKIP_CHANGELOG=1 git commit --amend --no-verify --no-edit
